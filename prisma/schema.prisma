generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MissionStatus {
  PLANNED
  DOING
  DONE
}

enum DeadlineStatus {
  ACTIVE
  COMPLETED
  MISSED
}

enum PostStatus {
  IDEA
  DRAFTING
  READY
  POSTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]

  missions      Mission[]
  deadlines     Deadline[]
  postIdeas     PostIdea[]
  canvases      Canvas[]
  weeklyReviews WeeklyReview[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Mission {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      MissionStatus @default(PLANNED)
  priority    Priority      @default(MEDIUM)
  category    String?
  dueDate     DateTime?
  order       Int           @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deadlineId String?
  deadline   Deadline? @relation(fields: [deadlineId], references: [id], onDelete: SetNull)

  canvasId String?
  canvas   Canvas? @relation(fields: [canvasId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([deadlineId])
  @@index([canvasId])
  @@index([dueDate])
  @@index([userId])
}

model Deadline {
  id          String         @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  category    String?
  status      DeadlineStatus @default(ACTIVE)
  priority    Priority       @default(MEDIUM)
  link        String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  missions Mission[]
  canvases Canvas[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([dueDate])
  @@index([userId])
}

model PostIdea {
  id           String     @id @default(cuid())
  title        String
  hook         String?
  draft        String?
  finalContent String?
  category     String?
  status       PostStatus @default(IDEA)
  postedUrl    String?
  order        Int        @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  canvasId String?
  canvas   Canvas? @relation(fields: [canvasId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([canvasId])
  @@index([userId])
}

model Canvas {
  id          String  @id @default(cuid())
  title       String
  description String?
  data        Json?
  thumbnail   String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deadlineId String?
  deadline   Deadline? @relation(fields: [deadlineId], references: [id], onDelete: SetNull)

  missions  Mission[]
  postIdeas PostIdea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deadlineId])
  @@index([userId])
}

model WeeklyReview {
  id        String   @id @default(cuid())
  weekStart DateTime
  weekEnd   DateTime

  wentRight String?
  wentWrong String?
  nextPlan  String?
  finalNote String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekStart])
  @@index([weekEnd])
  @@index([userId])
}
